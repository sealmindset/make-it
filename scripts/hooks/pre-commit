#!/usr/bin/env bash
# pre-commit -- dispatcher. Runs every part in scripts/hooks/pre-commit.d/ in
# lexical order, so a clone can hold more than one pre-commit behaviour at once.
#
# Install once per clone:
#   ln -sf ../../scripts/hooks/pre-commit .git/hooks/pre-commit
#
# WHY A DISPATCHER: git allows exactly one .git/hooks/pre-commit. This repo grew
# two independent ones -- a VERSION patch bumper and a CONTENT_MANIFEST
# regenerator -- and because both wanted the same filename, installing either
# silently destroyed the other. That is what happened in practice: the documented
# `ln -sf` above was never run in at least one clone, the bumper held the slot,
# and the manifest guarantee was quietly absent while the repo's own CI comment
# claimed the hook prevented stale manifests. A dispatcher removes the collision:
# parts are additive, and installing a new one cannot uninstall an existing one.
#
# ADDING A PART: drop an executable file in scripts/hooks/pre-commit.d/ named
# NN-name, where NN orders it. A part that exits non-zero aborts the commit.
# Parts run from the repository root. Anything a part stages with `git add` is
# included in the commit being made.

set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

parts_dir="$repo_root/scripts/hooks/pre-commit.d"
[ -d "$parts_dir" ] || exit 0   # nothing installed; nothing to do

shopt -s nullglob
for part in "$parts_dir"/*; do
  [ -f "$part" ] || continue
  case "$part" in
    *.md|*.disabled|*~) continue ;;   # docs and parked parts are not hooks
  esac

  if [ ! -x "$part" ]; then
    echo "pre-commit: skipping $(basename "$part") -- not executable" >&2
    continue
  fi

  if ! "$part"; then
    status=$?
    echo "pre-commit: $(basename "$part") failed (exit $status) -- commit aborted" >&2
    exit "$status"
  fi
done
