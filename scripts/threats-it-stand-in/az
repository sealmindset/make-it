#!/usr/bin/env python3
"""Stand-in for the Azure CLI: answers `az account get-access-token` with a made-up token, built here at run time.
It is not a credential and opens nothing. Its last part is a marker the tests look for: no script may print it."""
import base64
import json
import sys

if sys.argv[1:3] != ["account", "get-access-token"]:
    sys.exit("stand-in az: only `account get-access-token` is faked")
b64 = lambda d: base64.urlsafe_b64encode(json.dumps(d).encode()).decode().rstrip("=")
claims = {"aud": "stand-in", "tid": "00000000-aaaa-4bbb-8ccc-00000000dddd", "upn": "analyst@stand-in.example",
          "app_displayname": "Stand-in CLI", "scp": "Directory.Read.All", "wids": ["reader"]}
print(".".join([b64({"alg": "none"}), b64(claims), "STANDIN-TOKEN-MARKER"]))
