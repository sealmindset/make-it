#!/usr/bin/env bash
# Stand-in for `gh` in the board's tests: it answers from a file and never touches the network.
#   GH_STUB_PRS  the JSON file `gh pr list` prints (make-board.py writes one beside the board)
case "${1:-} ${2:-}" in
  "auth status") exit 0 ;;
  "pr view")  # --json files: the files that pull request changes, from files/<N>.json; anything else: its state
    case "$*" in
      *files*) cat "$(dirname "${GH_STUB_PRS:?}")/files/$3.json" 2>/dev/null || { echo "gh stand-in: no files for $3" >&2; exit 1; } ;;
      *) echo '{"state":"OPEN","mergedAt":null}' ;;
    esac ;;
  "api repos/{owner}/{repo}/compare/"*)  # how far a pull request's head is behind main, from behind/<head oid>
    cat "$(dirname "${GH_STUB_PRS:?}")/behind/${2##*...}" 2>/dev/null || { echo "gh stand-in: cannot compare" >&2; exit 1; } ;;
  "pr list") cat "${GH_STUB_PRS:?gh stand-in: set GH_STUB_PRS}" ;;
  *) echo "gh stand-in: unexpected call: $*" >&2; exit 1 ;;
esac
