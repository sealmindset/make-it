# Keep machine-local virtualenvs, caches and reports out of the image: the Dockerfile installs
# its own dependencies from requirements.txt.
.venv
venv
__pycache__
*.pyc
.pytest_cache
.ruff_cache
.mypy_cache
.coverage
coverage.json
htmlcov
.git

# Never copy local secrets into the image: config.py reads env_file=".env", and `COPY . .` puts the
# file in the final image. Configuration comes from the container's environment.
.env
.env.*
!.env.example
