# Keep machine-local installs and build output out of the image: the Dockerfile installs its own
# dependencies (deps stage, `npm ci`) for Linux. A host node_modules copied over them would mix in
# binaries built for the developer's machine.
node_modules
.next
coverage
*.tsbuildinfo
npm-debug.log*
.git

# Never copy local secrets into the image: `COPY . .` brings .env into the build stage, and Next's
# standalone output copies .env and .env.production into .next/standalone, which the runner ships.
.env
.env.*
!.env.example
