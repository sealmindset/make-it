#!/usr/bin/env python3
"""Stop hook: keep a Subagent-Driven Development run going until its gates pass.

A rule in a prompt is advice the controller can forget mid-run; a Stop hook is a
gate it cannot talk its way out of. When the main agent tries to end its turn
while an SDD run is open, this exits 2 with a reminder on stderr, which Claude
Code feeds back as the next instruction. It is a no-op outside an active run.

Ledger: <repo>/.make-it/sdd/progress.md (append-only lines)
  RUN: plan=<path> tasks=<N>     controller writes this when a run starts
  Task N: complete (...)         controller writes after each clean review
  STATUS: BLOCKED <why>          release: cannot proceed, human needed
  STATUS: AWAITING_HUMAN <what>  release: a question only the user can answer
  STATUS: DONE                   release: final whole-branch review clean
  RUN: resume                    re-arm after a STATUS once the human answered
  gate: nudged <time>            written by this hook (cap counter)

Which ledger: the one in the git repo of the session's cwd, plus any ledger
registered with `sdd-gate register <abs-path-to-progress.md>` whose path appears in
THIS session's transcript. Registration covers runs in a worktree or another repo
than the one the session started in; the transcript match keeps one session's run
from blocking another session. Registry: ~/.claude/sdd-runs (one path per line;
entries whose ledger no longer exists are pruned).

Fail-open everywhere: a bug here must never trap or block a real session.
"""
import datetime
import json
import os
import re
import subprocess
import sys

CAP = 3  # consecutive nudges with no task completed -> release to the human
REGISTRY = os.environ.get("SDD_GATE_REGISTRY") or os.path.expanduser("~/.claude/sdd-runs")


def read_registry():
    try:
        with open(REGISTRY) as f:
            return [l.strip() for l in f if l.strip()]
    except OSError:
        return []


def write_registry(paths):
    with open(REGISTRY, "w") as f:
        f.write("".join(p + "\n" for p in paths))


def register(path):
    path = os.path.abspath(path)
    paths = read_registry()
    if path not in paths:
        paths.append(path)
        write_registry(paths)
    print(f"sdd-gate: registered {path}")
    return 0


def candidate_ledgers(data):
    found = []
    cwd = data.get("cwd") or os.getcwd()
    try:
        top = subprocess.check_output(
            ["git", "-C", cwd, "rev-parse", "--show-toplevel"],
            stderr=subprocess.DEVNULL, text=True).strip()
        found.append(os.path.join(top, ".make-it", "sdd", "progress.md"))
    except Exception:
        pass
    paths = read_registry()
    live = [p for p in paths if os.path.isfile(p)]
    if live != paths:
        write_registry(live)
    transcript = data.get("transcript_path")
    if live and transcript:
        try:
            with open(transcript, errors="replace") as f:
                text = f.read()
        except OSError:
            text = ""
        found += [p for p in live if p in text and p not in found]
    return [p for p in found if os.path.isfile(p)]


def main():
    data = json.loads(sys.stdin.read() or "{}")
    for ledger in candidate_ledgers(data):
        rc = check(ledger)
        if rc:
            return rc
    return 0


def check(ledger):
    with open(ledger) as f:
        lines = [l.rstrip("\n") for l in f]

    run_i = start_i = None
    total = 0
    for i, l in enumerate(lines):
        m = re.match(r"\s*RUN:.*\btasks=(\d+)", l)
        if m:
            run_i, start_i, total = i, i, int(m.group(1))
        elif re.match(r"\s*RUN:\s*resume\b", l):
            run_i = i
    if run_i is None or total == 0:
        return 0  # no armed run in this ledger
    if any(re.match(r"\s*STATUS:", l) for l in lines[run_i + 1:]):
        return 0  # released until a `RUN: resume`

    done = set()
    last_progress = run_i
    for i, l in enumerate(lines[start_i + 1:], start_i + 1):
        m = re.match(r"\s*Task\s+(\d+):\s*complete", l)
        if m:
            done.add(int(m.group(1)))
            last_progress = max(last_progress, i)
    nudges = sum(1 for l in lines[last_progress + 1:] if l.startswith("gate: nudged"))
    if nudges >= CAP:
        return 0  # cap already reached and recorded; stay released

    pending = [n for n in range(1, total + 1) if n not in done]
    stamp = datetime.datetime.now().isoformat(timespec="seconds")
    with open(ledger, "a") as f:
        f.write(f"gate: nudged {stamp}\n")
        if nudges + 1 >= CAP:
            f.write(f"gate: cap {CAP} reached with no progress, released to human {stamp}\n")

    if pending:
        todo = (f"{len(done)}/{total} checkpoints complete; next is Task {pending[0]}. "
                "Continue the plan (subagent-driven-development.md): dispatch the next "
                "implementer / reviewer / fix loop.")
    else:
        todo = (f"all {total} checkpoints complete but the run is still open. Run the final "
                "whole-branch review, fix its findings, then append `STATUS: DONE`.")
    sys.stderr.write(
        f"SDD gate: {todo} Do not stop to ask whether to continue. "
        f"Escape hatches (append ONE line to {ledger}): "
        "`STATUS: BLOCKED <why>` if you cannot proceed; `STATUS: AWAITING_HUMAN <what>` if only "
        "the user can answer; `STATUS: DONE` when finished. After the user answers, append "
        f"`RUN: resume` to re-arm the gate. Nudge {nudges + 1}/{CAP}; after nudge {CAP} the gate releases.")
    return 2


try:
    if len(sys.argv) == 3 and sys.argv[1] == "register":
        sys.exit(register(sys.argv[2]))
    sys.exit(main())
except Exception:
    sys.exit(0)
